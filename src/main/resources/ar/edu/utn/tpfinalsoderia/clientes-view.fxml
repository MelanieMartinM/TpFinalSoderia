<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ar.edu.utn.tpfinalsoderia.controllers.ClientesController"
      spacing="15"
      style="-fx-background-color: #f2f8fc;">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Gestión de clientes"
           style="-fx-font-size: 22px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #283783;"/>

    <GridPane hgap="12" vgap="10">

        <Label text="Nombre:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="campoNombre"
                   promptText="Nombre del cliente"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="Teléfono:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="campoTelefono"
                   promptText="Teléfono"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

        <Label text="Dirección:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <TextField fx:id="campoDireccion"
                   promptText="Dirección"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>

    </GridPane>

    <HBox spacing="10">

        <Button text="Guardar"
                onAction="#guardarCliente"
                style="-fx-background-color: #00a7db;
                       -fx-text-fill: white;"/>

        <Button text="Actualizar"
                onAction="#actualizarCliente"/>

        <Button text="Desactivar"
                onAction="#desactivarCliente"/>

        <Button text="Limpiar"
                onAction="#limpiarFormulario"/>

    </HBox>

    <Label fx:id="mensaje"
           wrapText="true"
           style="-fx-text-fill: #283783;"/>

    <TableView fx:id="tablaClientes"
               prefHeight="260">

        <columns>

            <TableColumn fx:id="columnaNombre"
                         text="Nombre"
                         prefWidth="180"/>

            <TableColumn fx:id="columnaTelefono"
                         text="Teléfono"
                         prefWidth="130"/>

            <TableColumn fx:id="columnaDireccion"
                         text="Dirección"
                         prefWidth="200"/>

        </columns>

    </TableView>

</VBox>