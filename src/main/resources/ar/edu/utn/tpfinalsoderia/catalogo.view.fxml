<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ar.edu.utn.tpfinalsoderia.controllers.CatalogoController" spacing="10" style="-fx-padding: 15;">
    <Label text="Catálogo de presentaciones"/>
    <Label text="El precio se ingresa por unidad. La tarifa por seis sifones requiere configuración adicional." wrapText="true"/>
    <TableView fx:id="tblPresentaciones" prefHeight="330">
        <columns>
            <TableColumn fx:id="colId" text="ID" visible="false"/>
            <TableColumn fx:id="colNombre" text="Presentación" prefWidth="210"/>
            <TableColumn fx:id="colProducto" text="Producto" prefWidth="150"/>
            <TableColumn fx:id="colPrecio" text="Precio unitario" prefWidth="150"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
        </columns>
    </TableView>
    <HBox spacing="8">
        <TextField fx:id="txtNuevoPrecio" promptText="Nuevo precio por unidad"/>
        <Button text="Actualizar precio" onAction="#onActualizarPrecio"/>
        <Button text="Desactivar" onAction="#onDesactivarPresentacion"/>
        <Button text="Actualizar lista" onAction="#cargarCatalogo"/>
    </HBox>
    <Label fx:id="lblEstado" wrapText="true"/>
</VBox>
