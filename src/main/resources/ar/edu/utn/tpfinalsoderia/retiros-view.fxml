<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ar.edu.utn.tpfinalsoderia.controllers.RetirosController" prefWidth="980" prefHeight="680">
    <top>
        <VBox spacing="4" style="-fx-background-color: #1e3a5f; -fx-padding: 14;">
            <Label text="Retiros y cobros - Sodería" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Seleccioná las opciones por nombre. Los identificadores se usan internamente."
                   style="-fx-text-fill: #d0e1f9;"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="10">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Repartidor:"/>
                    <ComboBox fx:id="cmbCliente" promptText="Elegí un repartidor" onAction="#onSeleccionCliente" prefWidth="250"/>
                    <Label text="Pedido:"/>
                    <ComboBox fx:id="cmbPedido" promptText="Sin pedido (opcional)" onAction="#onSeleccionPedido" prefWidth="260"/>
                    <Button text="Sin pedido" onAction="#onQuitarPedido"/>
                    <Button text="Actualizar listas" onAction="#cargarOpciones"/>
                </HBox>
                <GridPane hgap="8" vgap="8">
                    <Label text="Detalle del pedido:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbDetallePedido" promptText="Elegí un producto pendiente" onAction="#onSeleccionDetalle" prefWidth="260" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Pendientes:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <TextField fx:id="txtCantidadPedida" editable="false" prefWidth="70" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                    <Label text="Presentación sin pedido:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbPresentacion" promptText="Elegí una presentación" onAction="#onSeleccionPresentacion" prefWidth="260" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Unidades:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <TextField fx:id="txtCantidadRetirada" promptText="Cantidad" prefWidth="70" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                    <Label text="Precio unitario:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtPrecioAplicado" promptText="Precio" prefWidth="120" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Tipo y cantidad de cajones:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <HBox spacing="6" GridPane.rowIndex="3" GridPane.columnIndex="1">
                        <ComboBox fx:id="cmbTipoCajon" promptText="Tipo de cajón" prefWidth="200"/>
                        <TextField fx:id="txtCantidadCajones" promptText="0" prefWidth="60"/>
                    </HBox>
                    <HBox spacing="6" GridPane.rowIndex="3" GridPane.columnIndex="2" GridPane.columnSpan="2">
                        <Button text="Agregar producto" onAction="#onAgregarDetalle"/>
                        <Button text="Vaciar lista" onAction="#onVaciarDetalles"/>
                    </HBox>
                </GridPane>
                <TableView fx:id="tblDetalles" prefHeight="130">
                    <columns>
                        <TableColumn fx:id="colDetPres" text="Presentación" prefWidth="180"/>
                        <TableColumn fx:id="colDetPedido" text="Pedidas" prefWidth="90"/>
                        <TableColumn fx:id="colDetRetirado" text="Retiradas" prefWidth="90"/>
                        <TableColumn fx:id="colDetPrecio" text="Precio" prefWidth="100"/>
                        <TableColumn fx:id="colDetCajones" text="Cajones" prefWidth="90"/>
                        <TableColumn fx:id="colDetSubtotal" text="Subtotal" prefWidth="120"/>
                    </columns>
                </TableView>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="lblTotalRetiro" text="Total a retirar: $0"/>
                    <Label text="Medio:"/><ComboBox fx:id="cmbMedioPago" prefWidth="110"/>
                    <Label text="Monto:"/><TextField fx:id="txtMontoCobro" prefWidth="100"/>
                    <CheckBox fx:id="chkSinCobro" text="Paga después" onAction="#onToggleSinCobro"/>
                    <Button text="Confirmar retiro" onAction="#onConfirmarRetiro"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Pago posterior:"/>
                    <ComboBox fx:id="cmbRetiroPendiente" promptText="Elegí un retiro pendiente" prefWidth="300"/>
                    <ComboBox fx:id="cmbMedioPosterior" prefWidth="110"/>
                    <TextField fx:id="txtMontoPosterior" promptText="Monto" prefWidth="100"/>
                    <Button text="Registrar pago" onAction="#onCobrarPosterior"/>
                </HBox>
                <Label text="La tarifa proporcional de seis sifones aún requiere configuración y pruebas." wrapText="true" style="-fx-text-fill: #a15c00;"/>
                <Label fx:id="lblEstado" wrapText="true"/>
                <Label text="Cobros registrados" style="-fx-font-weight: bold;"/>
                <TableView fx:id="tblCobros" prefHeight="120">
                    <columns>
                        <TableColumn fx:id="colCobFecha" text="Fecha" prefWidth="160"/>
                        <TableColumn fx:id="colCobMonto" text="Monto" prefWidth="120"/>
                        <TableColumn fx:id="colCobMedio" text="Medio" prefWidth="150"/>
                        <TableColumn fx:id="colCobAut" text="Estado" prefWidth="200"/>
                    </columns>
                </TableView>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
