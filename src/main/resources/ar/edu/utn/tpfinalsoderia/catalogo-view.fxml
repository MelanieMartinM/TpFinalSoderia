<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ar.edu.utn.tpfinalsoderia.controllers.CatalogoController"
            prefWidth="900.0" prefHeight="600.0"
            style="-fx-background-color: #f2f8fc;">

    <top>
        <VBox spacing="4.0" style="-fx-background-color: #1e3a5f; -fx-padding: 14;">
            <Label text="Catálogo y Precios - Sodería"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Consulta de presentaciones, actualización de precio de llenado y baja lógica"
                   style="-fx-text-fill: #d0e1f9; -fx-font-size: 12px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12.0">
            <padding>
                <Insets top="16" right="20" bottom="16" left="20"/>
            </padding>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button text="Refrescar Catálogo"
                        onAction="#cargarCatalogo"
                        style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label text="Nuevo Precio:"/>
                <TextField fx:id="txtNuevoPrecio"
                           promptText="Ej: 1500.00"
                           prefWidth="140.0"/>
                <Button text="Actualizar Precio"
                        onAction="#onActualizarPrecio"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Desactivar Presentación"
                        onAction="#onDesactivarPresentacion"
                        style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>

            <Label fx:id="lblEstado"
                   text=""
                   wrapText="true"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

            <TableView fx:id="tblPresentaciones" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="120.0"/>
                    <TableColumn fx:id="colNombre" text="Presentación" prefWidth="240.0"/>
                    <TableColumn fx:id="colProducto" text="Producto" prefWidth="200.0"/>
                    <TableColumn fx:id="colPrecio" text="Precio Llenado" prefWidth="150.0"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="120.0"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>