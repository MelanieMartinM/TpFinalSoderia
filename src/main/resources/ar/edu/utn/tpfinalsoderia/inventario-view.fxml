<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ar.edu.utn.tpfinalsoderia.controllers.InventarioController"
            prefWidth="950.0" prefHeight="650.0">

    <top>
        <VBox spacing="5.0" style="-fx-background-color: #1e3a5f; -fx-padding: 15;">
            <Label text="Gestión de Inventario y Producción - Sodería"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Control de envases vacíos (sucios / aptos), lavado y stock de producto terminado (fábrica y fasón)"
                   style="-fx-text-fill: #d0e1f9; -fx-font-size: 12px;"/>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <!-- PESTAÑA 1: OPERACIONES (RECEPCIÓN, LAVADO, PRODUCCIÓN) -->
            <Tab text="Movimientos de Planta">
                <VBox spacing="15.0">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <TitledPane text="Registrar Operación de Inventario" collapsible="false">
                        <GridPane hgap="15.0" vgap="12.0">
                            <padding>
                                <Insets top="15" right="15" bottom="15" left="15"/>
                            </padding>

                            <Label text="Tipo de Operación:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="cmbOperacion" prefWidth="280.0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Titular (Fábrica o Cliente Fasón):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <HBox spacing="10.0" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <CheckBox fx:id="chkEsFason" text="Es Fasón (Cliente)" onAction="#onToggleFason"/>
                                <TextField fx:id="txtClienteId" promptText="ID Cliente (ej: C001)" disable="true" prefWidth="150.0"/>
                            </HBox>

                            <Label text="ID Envase (para Recepción / Lavado):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="txtEnvaseId" promptText="Ej: ENV-SIF-1500" prefWidth="280.0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="ID Presentación (solo Producción):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <TextField fx:id="txtPresentacionId" promptText="Ej: 1" disable="true" prefWidth="280.0" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="Cantidad:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <TextField fx:id="txtCantidad" promptText="Cantidad de unidades" prefWidth="280.0" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                            <HBox spacing="10.0" GridPane.rowIndex="5" GridPane.columnIndex="1">
                                <Button text="Confirmar Operación" onAction="#onConfirmarOperacion"
                                        style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16;"/>
                                <Button text="Limpiar" onAction="#onLimpiarFormulario"
                                        style="-fx-padding: 8 16;"/>
                            </HBox>
                        </GridPane>
                    </TitledPane>

                    <Label fx:id="lblEstado" text="" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                </VBox>
            </Tab>

            <!-- PESTAÑA 2: STOCK ACTUAL DE ENVASES Y PRODUCTOS -->
            <Tab text="Stock Actual">
                <VBox spacing="15.0">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>

                    <HBox spacing="10.0" alignment="CENTER_RIGHT">
                        <Button text="Actualizar Tablas" onAction="#cargarDatosTablas"
                                style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-padding: 6 14;"/>
                    </HBox>

                    <Label text="Stock de Envases Vacíos (Aptos vs. Sucios)" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <TableView fx:id="tblStockEnvases" prefHeight="220.0">
                        <columns>
                            <TableColumn fx:id="colEnvTitular" text="Titular" prefWidth="180.0"/>
                            <TableColumn fx:id="colEnvCodigo" text="Envase" prefWidth="220.0"/>
                            <TableColumn fx:id="colEnvAptos" text="Aptos (Limpios)" prefWidth="160.0"/>
                            <TableColumn fx:id="colEnvSucios" text="Sucios (A lavar)" prefWidth="160.0"/>
                        </columns>
                    </TableView>

                    <Label text="Stock de Productos Llenos Disponibles" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <TableView fx:id="tblStockProductos" prefHeight="220.0">
                        <columns>
                            <TableColumn fx:id="colProdTitular" text="Titular" prefWidth="200.0"/>
                            <TableColumn fx:id="colProdPresentacion" text="Presentación ID" prefWidth="250.0"/>
                            <TableColumn fx:id="colProdDisponibles" text="Disponibles" prefWidth="200.0"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- PESTAÑA 3: HISTORIAL DE MOVIMIENTOS -->
            <Tab text="Historial de Movimientos">
                <VBox spacing="10.0">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>
                    <TableView fx:id="tblMovimientos" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMovFecha" text="Fecha y Hora" prefWidth="180.0"/>
                            <TableColumn fx:id="colMovTipo" text="Tipo Movimiento" prefWidth="160.0"/>
                            <TableColumn fx:id="colMovTitular" text="Titular" prefWidth="180.0"/>
                            <TableColumn fx:id="colMovEnvase" text="Envase" prefWidth="180.0"/>
                            <TableColumn fx:id="colMovCantidad" text="Cantidad" prefWidth="120.0"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>