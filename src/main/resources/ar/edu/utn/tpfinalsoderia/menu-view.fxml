<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:id="contenidoPrincipal"
            fx:controller="ar.edu.utn.tpfinalsoderia.controllers.MenuController"
            style="-fx-background-color: #f2f8fc;">

    <center>

        <VBox alignment="CENTER"
              spacing="14">

            <padding>
                <Insets top="25" right="25"
                        bottom="25" left="25"/>
            </padding>

            <Label text="Sistema de Sodería"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #283783;"/>

            <Label text="Menú principal"
                   style="-fx-font-size: 17px;
                          -fx-text-fill: #283783;"/>

            <Label fx:id="etiquetaUsuario"
                   wrapText="true"
                   style="-fx-font-size: 13px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #283783;
                          -fx-background-color: #e0eaf2;
                          -fx-background-radius: 6;
                          -fx-padding: 10;"/>

            <Button text="Clientes"
                    prefWidth="200"
                    onAction="#abrirClientes"
                    style="-fx-background-color: #00a7db;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-background-radius: 6;"/>

            <Button text="Inventario"
                    prefWidth="200"
                    onAction="#abrirInventario"
                    style="-fx-background-color: #00a7db;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-background-radius: 6;"/>

            <Button text="Catálogo"
                    prefWidth="200"
                    onAction="#abrirCatalogo"
                    style="-fx-background-color: #00a7db;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-background-radius: 6;"/>

            <Button text="Pedidos"
                    prefWidth="200"
                    onAction="#abrirPedidos"
                    style="-fx-background-color: #00a7db;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-background-radius: 6;"/>

            <Button text="Retiros y cobros"
                    prefWidth="200"
                    onAction="#abrirRetiros"
                    style="-fx-background-color: #00a7db;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-background-radius: 6;"/>

            <Button fx:id="botonReportes"
                    text="Reportes"
                    prefWidth="200"
                    onAction="#abrirReportes"
                    style="-fx-background-color: #00a7db;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-background-radius: 6;"/>

            <Button text="Cerrar sesión"
                    prefWidth="200"
                    onAction="#cerrarSesion"
                    style="-fx-background-color: #283783;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;"/>

            <Label fx:id="mensaje"
                   wrapText="true"
                   style="-fx-text-fill: #283783;"/>

        </VBox>

    </center>

</BorderPane>