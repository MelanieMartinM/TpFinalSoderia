<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ar.edu.utn.tpfinalsoderia.controllers.PedidosController" spacing="10" style="-fx-padding: 15;">
    <Label text="Pedidos por repartidor"/>
    <Label text="Atención: la tarifa por seis sifones todavía requiere configuración y definición de redondeo." wrapText="true"/>
    <HBox spacing="8">
        <Label text="Repartidor"/><ComboBox fx:id="cmbCliente" prefWidth="220"/>
        <Label text="Presentación"/><ComboBox fx:id="cmbPresentacion" prefWidth="260"/>
    </HBox>
    <HBox spacing="8">
        <Label text="Unidades"/><TextField fx:id="txtCantidadUnidades" prefWidth="80"/>
        <Label text="Cajones físicos"/><TextField fx:id="txtCantidadCajones" prefWidth="80"/>
        <ComboBox fx:id="cmbTipoCajon" promptText="Tipo de cajón" prefWidth="180"/>
        <Button text="Agregar" onAction="#onAgregarDetalle"/>
    </HBox>
    <TableView fx:id="tblDetalles" prefHeight="280">
        <columns>
            <TableColumn fx:id="colPresentacion" text="Presentación" prefWidth="220"/>
            <TableColumn fx:id="colUnidades" text="Unidades" prefWidth="100"/>
            <TableColumn fx:id="colCajones" text="Cajones" prefWidth="100"/>
            <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="150"/>
        </columns>
    </TableView>
    <HBox spacing="10"><Label fx:id="lblTotal"/><Button text="Confirmar pedido" onAction="#onConfirmarPedido"/></HBox>
    <Label fx:id="lblEstado" wrapText="true"/>
</VBox>
