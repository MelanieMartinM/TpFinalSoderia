<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ar.edu.utn.tpfinalsoderia.controllers.LoginController"
      alignment="CENTER"
      spacing="12"
      style="-fx-background-color: #f2f8fc;">

    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <ImageView fitWidth="180"
               fitHeight="115"
               preserveRatio="true">
        <image>
            <Image url="@Logo.png"/>
        </image>
    </ImageView>

    <Label text="Inicio de sesión"
           style="-fx-font-size: 20px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #283783;"/>

    <TextField fx:id="campoUsuario"
               promptText="Usuario"
               maxWidth="250"
               style="-fx-font-size: 14px;"/>

    <PasswordField fx:id="campoContrasena"
                   promptText="Contraseña"
                   maxWidth="250"
                   style="-fx-font-size: 14px;"/>

    <Button text="Ingresar"
            onAction="#iniciarSesion"
            prefWidth="150"
            style="-fx-background-color: #00a7db;
                   -fx-text-fill: white;
                   -fx-font-size: 14px;
                   -fx-font-weight: bold;
                   -fx-background-radius: 6;"/>

    <Label fx:id="mensaje"
           wrapText="true"
           style="-fx-text-fill: #283783;"/>

</VBox>