<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ar.edu.utn.tpfinalsoderia.controllers.PedidosController"
            prefWidth="920.0" prefHeight="620.0"
            style="-fx-background-color: #f2f8fc;">

    <top>
        <VBox spacing="4.0" style="-fx-background-color: #1e3a5f; -fx-padding: 14;">
            <Label text="Gestión de Pedidos - Sodería"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Creación de pedidos, carga de ítems y confirmación"
                   style="-fx-text-fill: #d0e1f9; -fx-font-size: 12px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets top="16" right="20" bottom="16" left="20"/>
            </padding>

            <GridPane hgap="10.0" vgap="10.0">
                <Label text="Cliente:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbCliente"
                          promptText="Seleccionar cliente"
                          prefWidth="240.0"
                          GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Presentación:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <ComboBox fx:id="cmbPresentacion"
                          promptText="Seleccionar presentación"
                          prefWidth="240.0"
                          GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Unidades:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCantidadUnidades"
                           promptText="Ej: 12"
                           prefWidth="120.0"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Tipo Cajón:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <ComboBox fx:id="cmbTipoCajon"
                          promptText="Opcional si cajones = 0"
                          prefWidth="240.0"
                          GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="Cajones:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCantidadCajones"
                           promptText="0"
                           prefWidth="120.0"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Button text="Agregar Ítem"
                        onAction="#onAgregarDetalle"
                        style="-fx-background-color: #00a7db; -fx-text-fill: white; -fx-font-weight: bold;"
                        GridPane.rowIndex="2" GridPane.columnIndex="3"/>
            </GridPane>

            <TableView fx:id="tblDetalles" prefHeight="240.0">
                <columns>
                    <TableColumn fx:id="colPresentacion" text="Presentación" prefWidth="280.0"/>
                    <TableColumn fx:id="colUnidades" text="Unidades" prefWidth="130.0"/>
                    <TableColumn fx:id="colCajones" text="Cajones" prefWidth="130.0"/>
                    <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="160.0"/>
                </columns>
            </TableView>

            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <Label fx:id="lblTotal"
                       text="Total: $0,00"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #283783;"/>
                <Button text="Confirmar Pedido"
                        onAction="#onConfirmarPedido"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16;"/>
            </HBox>

            <Label fx:id="lblEstado"
                   text=""
                   wrapText="true"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
        </VBox>
    </center>

</BorderPane>